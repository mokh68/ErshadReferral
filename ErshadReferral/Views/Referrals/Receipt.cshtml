@model Referral
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>قبض ارجاع @Model.ReferralNumber</title>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: Tahoma, Arial, sans-serif;
            direction: rtl;
            background: #fff;
        }
        .no-print {
            text-align: center;
            padding: 10px;
            background: #f5f5f5;
        }
        .receipt {
            width: 80mm;
            margin: 0 auto;
            padding: 3mm 4mm;
            font-size: 9pt;
            line-height: 1.6;
            color: #000;
            background: #fff;
        }
        .receipt-header {
            text-align: center;
            border-bottom: 2px dashed #000;
            padding-bottom: 3mm;
            margin-bottom: 3mm;
        }
        .receipt-header h3 {
            font-size: 11pt;
            margin-bottom: 1mm;
            font-weight: 700;
        }
        .receipt-header h4 {
            font-size: 10pt;
            font-weight: 600;
            color: #333;
        }
        .receipt-row {
            display: flex;
            justify-content: space-between;
            padding: 1.5mm 0;
            border-bottom: 1px dotted #ccc;
            font-size: 8.5pt;
        }
        .receipt-row .label {
            font-weight: 600;
            color: #333;
        }
        .receipt-row .value {
            text-align: left;
            direction: ltr;
        }
        .receipt-row-full {
            padding: 1.5mm 0;
            border-bottom: 1px dotted #ccc;
            font-size: 8.5pt;
        }
        .receipt-row-full .label {
            font-weight: 600;
        }
        .barcode-section {
            text-align: center;
            margin: 3mm 0;
            padding: 2mm 0;
            border-top: 2px dashed #000;
            border-bottom: 2px dashed #000;
        }
        .barcode-section svg {
            max-width: 100%;
        }
        .receipt-footer {
            text-align: center;
            margin-top: 3mm;
            font-size: 7.5pt;
            color: #666;
        }
        .subject-box {
            background: #f8f8f8;
            border: 1px solid #ddd;
            border-radius: 2mm;
            padding: 2mm;
            margin: 2mm 0;
            font-size: 8pt;
            word-wrap: break-word;
        }
        .divider {
            border: none;
            border-top: 1px dashed #999;
            margin: 2mm 0;
        }
        .big-text {
            font-size: 10pt;
            font-weight: 700;
        }
        .print-btn {
            font-size: 14px;
            padding: 8px 24px;
            margin: 5px;
        }
        @@media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .receipt {
                width: 80mm;
                margin: 0;
                padding: 2mm 3mm;
            }
            @@page {
                size: 80mm auto;
                margin: 0;
            }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <p style="margin-bottom:8px;color:#666;">پیش‌نمایش قبض چاپ پرینتر حرارتی (۸ سانتی‌متر)</p>
        <button onclick="window.print()" class="btn btn-primary print-btn">
            <i class="bi bi-printer ms-1"></i>چاپ قبض
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary print-btn">
            <i class="bi bi-x-circle ms-1"></i>بستن
        </button>
    </div>

    <div class="receipt" id="receipt">
        <!-- Header -->
        <div class="receipt-header">
            <h3>سامانه ارجاعات ارشاد</h3>
            <h4>قبض ارجاع</h4>
        </div>

        <!-- Referral Info -->
        <div class="receipt-row">
            <span class="label">شماره ارجاع:</span>
            <span class="value big-text">@Model.ReferralNumber</span>
        </div>
        <div class="receipt-row">
            <span class="label">تاریخ:</span>
            <span class="value">@Model.ReferralDate.ToPersianDate()</span>
        </div>
        <div class="receipt-row">
            <span class="label">ساعت:</span>
            <span class="value">@Model.ReferralDate.ToString("HH:mm")</span>
        </div>

        <hr class="divider" />

        <!-- Person Info -->
        <div class="receipt-row">
            <span class="label">نام:</span>
            <span class="value">@Model.Person?.FullName</span>
        </div>
        <div class="receipt-row">
            <span class="label">کد ملی:</span>
            <span class="value" dir="ltr">@Model.Person?.NationalCode</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Person?.Mobile))
        {
            <div class="receipt-row">
                <span class="label">موبایل:</span>
                <span class="value" dir="ltr">@Model.Person.Mobile</span>
            </div>
        }

        <hr class="divider" />

        <!-- Branch Info -->
        <div class="receipt-row">
            <span class="label">شعبه مقصد:</span>
            <span class="value">@Model.Branch?.Name</span>
        </div>
        <div class="receipt-row">
            <span class="label">دادگاه:</span>
            <span class="value">@Model.Branch?.Court?.Name</span>
        </div>

        <!-- Subject -->
        <div class="receipt-row-full">
            <span class="label">موضوع:</span>
            <div class="subject-box">@Model.Subject</div>
        </div>

        <!-- Barcode -->
        <div class="barcode-section">
            <svg id="barcode"></svg>
        </div>

        <!-- Footer -->
        <div class="receipt-footer">
            <div>سامانه ردیابی ارجاعات واحد ارشاد</div>
            <div>@DateTime.Now.ToString("yyyy/MM/dd - HH:mm")</div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var nationalCode = '@Model.Person?.NationalCode';
            if (nationalCode && nationalCode.length === 10) {
                JsBarcode("#barcode", nationalCode, {
                    format: "CODE128",
                    width: 1.5,
                    height: 40,
                    displayValue: true,
                    fontSize: 14,
                    margin: 5,
                    textMargin: 2,
                    fontOptions: "bold"
                });
            }

            // Auto-print after 500ms
            setTimeout(function () {
                window.print();
            }, 500);
        });
    </script>
</body>
</html>
