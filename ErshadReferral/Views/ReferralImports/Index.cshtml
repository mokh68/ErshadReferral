@model ReferralExcelImportViewModel
@{
    ViewData["Title"] = "ایمپورت نوبت‌های اکسل";
}

<div class="page-header animate-fade-in">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h4><i class="bi bi-file-earmark-spreadsheet ms-2"></i>ایمپورت روزانهٔ نوبت‌ها</h4>
        <a asp-controller="Referrals" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right ms-1"></i>بازگشت به ارجاعات
        </a>
    </div>
</div>

<div class="card animate-fade-in">
    <div class="card-header">
        <h6 class="mb-0">بارگذاری فایل اکسل</h6>
    </div>
    <div class="card-body">
        <p class="text-muted">فایل روزانهٔ نوبت‌ها را با قالب xlsx انتخاب کن. تاریخ ثبت ارجاع، تاریخ جاری سرور خواهد بود.</p>
        <p class="text-muted">کد ملی تکراری به‌تنهایی باعث حذف ردیف نمی‌شود؛ فقط ردیف کاملاً تکراری یا فایلی که قبلاً وارد شده باشد دوباره ثبت نمی‌شود.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }

        <form asp-action="Index" method="post" enctype="multipart/form-data" class="mt-3">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="File" class="form-label"></label>
                <input asp-for="File" type="file" accept=".xlsx" class="form-control" />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-upload ms-1"></i>ایمپورت فایل
            </button>
        </form>
    </div>
</div>

@if (Model.Summary is not null)
{
    <div class="card mt-4 animate-fade-in">
        <div class="card-header"><h6 class="mb-0">نتیجهٔ ایمپورت</h6></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3"><strong>ردیف‌های فایل:</strong> @Model.Summary.TotalRows</div>
                <div class="col-md-3"><strong>ارجاع‌های ثبت‌شده:</strong> @Model.Summary.ImportedRows</div>
                <div class="col-md-3"><strong>ردیف تکراریِ ردشده:</strong> @Model.Summary.SkippedDuplicateRows</div>
                <div class="col-md-3"><strong>افراد جدید:</strong> @Model.Summary.NewPeople</div>
                <div class="col-md-3"><strong>استفاده از افراد موجود:</strong> @Model.Summary.ReusedPeople</div>
                <div class="col-md-3"><strong>تطبیق شعبه:</strong> @Model.Summary.MappedBranchRows</div>
                <div class="col-md-3"><strong>شعبهٔ نامنطبق:</strong> @Model.Summary.UnmappedBranchRows</div>
                <div class="col-md-3"><strong>تطبیق علت:</strong> @Model.Summary.MappedSubjectRows</div>
                <div class="col-md-3"><strong>علت نامنطبق:</strong> @Model.Summary.UnmappedSubjectRows</div>
                @if (Model.Summary.InvalidNationalCodeRows > 0 || Model.Summary.MissingLastNameRows > 0)
                {
                    <div class="col-12">
                        <div class="alert alert-warning mb-0">
                            @if (Model.Summary.InvalidNationalCodeRows > 0)
                            {
                                <span>@Model.Summary.InvalidNationalCodeRows کد ملی خارج از قالب ۱۰ رقمی بود؛ مقدار فایل حفظ شد.</span>
                            }
                            @if (Model.Summary.MissingLastNameRows > 0)
                            {
                                <span>@Model.Summary.MissingLastNameRows نام خانوادگی خالی بود و با «نامشخص» ثبت شد.</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
