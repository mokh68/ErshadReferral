@model Referral
@{
    ViewData["Title"] = $"چاپ ارجاع {Model.ReferralNumber}";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>چاپ ارجاع @Model.ReferralNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { 
            font-family: Tahoma, Arial, sans-serif; 
            font-size: 12pt;
            background: #fff;
        }
        .no-print { display: none; }
        .print-header { 
            border-bottom: 3px double #1a237e; 
            padding-bottom: 15px; 
            margin-bottom: 25px;
            text-align: center;
        }
        .print-header h4 {
            color: #1a237e;
            font-weight: 700;
        }
        .print-header h5 {
            color: #0d47a1;
            margin-top: 10px;
        }
        .info-row { 
            margin-bottom: 12px; 
            padding: 8px 0;
            border-bottom: 1px dotted #e0e0e0;
        }
        .info-row strong { 
            display: inline-block; 
            min-width: 130px; 
            color: #333;
        }
        .section-title {
            color: #1a237e;
            font-weight: 600;
            border-bottom: 2px solid #00bcd4;
            padding-bottom: 5px;
            margin-bottom: 15px;
        }
        .signature-section {
            margin-top: 60px;
        }
        .signature-line {
            border-top: 1px solid #333;
            padding-top: 10px;
            text-align: center;
            color: #555;
        }
        @@media print {
            body { font-size: 11pt; }
            .no-print { display: none !important; }
            .no-print * { display: none !important; }
        }
    </style>
</head>
<body class="p-4">
    <div class="no-print text-center mb-3">
        <button onclick="window.print()" class="btn btn-primary btn-sm">
            <i class="bi bi-printer ms-1"></i>چاپ
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-x-circle ms-1"></i>بستن
        </button>
    </div>

    <div class="print-header">
        <h4><i class="bi bi-building ms-2"></i>سامانه ارجاعات واحد ارشاد</h4>
        <h5>برگه ارجاع شماره: @Model.ReferralNumber</h5>
    </div>

    <div class="row mb-4">
        <div class="col-6 info-row">
            <strong>شماره ارجاع:</strong> @Model.ReferralNumber
        </div>
        <div class="col-6 info-row text-start">
            <strong>تاریخ ارجاع:</strong> @Model.ReferralDate.ToPersianDate()
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-6 info-row">
            <strong>وضعیت:</strong> @Model.Status.GetDisplayName()
        </div>
        <div class="col-6 info-row text-start">
            <strong>ثبت‌کننده:</strong> @Model.CreatedByUserName
        </div>
    </div>

    <hr />

    <h6 class="section-title"><i class="bi bi-person ms-1"></i>اطلاعات مراجع</h6>
    <div class="row mb-4">
        <div class="col-4 info-row">
            <strong>نام:</strong> @Model.Person?.FullName
        </div>
        <div class="col-4 info-row">
            <strong>کد ملی:</strong> @Model.Person?.NationalCode
        </div>
        <div class="col-4 info-row">
            <strong>موبایل:</strong> @(Model.Person?.Mobile ?? "—")
        </div>
    </div>

    <hr />

    <h6 class="section-title"><i class="bi bi-folder2 ms-1"></i>اطلاعات ارجاع</h6>
    <div class="info-row">
        <strong>شعبه مقصد:</strong> @(Model.Branch?.Court?.Name + " - " + Model.Branch?.Name)
    </div>
    <div class="info-row">
        <strong>موضوع:</strong> @Model.Subject
    </div>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="info-row">
            <strong>شرح:</strong> @Model.Description
        </div>
    }

    <div class="signature-section">
        <div class="row">
            <div class="col-4 text-center">
                <div class="signature-line">
                    <small>امضاء ثبت‌کننده</small>
                </div>
            </div>
            <div class="col-4 text-center">
                <div class="signature-line">
                    <small>امضاء رئیس واحد ارشاد</small>
                </div>
            </div>
            <div class="col-4 text-center">
                <div class="signature-line">
                    <small>امضاء رئیس شعبه</small>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
