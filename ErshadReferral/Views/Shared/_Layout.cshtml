@using ErshadReferral.Models
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه ارجاعات واحد ارشاد</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow-sm main-nav">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building fs-4"></i>
                    <span class="brand-text">سامانه ارجاعات ارشاد</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">
                            @if (User.IsInRole(AppRoles.OfficeManager) || User.IsInRole(AppRoles.BranchUser))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="VisitorEntries" asp-action="OfficeManager">
                                        <i class="bi bi-house-door ms-1"></i>صفحه اصلی
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(AppRoles.EntryController))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="VisitorEntries" asp-action="EntryControllerDashboard">
                                        <i class="bi bi-shield-check ms-1"></i>کنترل ورودی
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-speedometer2 ms-1"></i>داشبورد
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="Referrals" asp-action="Index">
                                        <i class="bi bi-folder2-open ms-1"></i>ارجاعات
                                    </a>
                                </li>
                                @if (User.IsInRole(AppRoles.IT) || User.IsInRole(AppRoles.ErshadManager))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link px-3" asp-controller="VisitorEntries" asp-action="Index">
                                            <i class="bi bi-door-open ms-1"></i>ورود/خروج مراجعه‌کنندگان
                                        </a>
                                    </li>
                                }
                                @if (User.IsInRole(AppRoles.IT) || User.IsInRole(AppRoles.ErshadManager))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link px-3" asp-controller="Referrals" asp-action="Create">
                                            <i class="bi bi-plus-circle ms-1"></i>ثبت ارجاع جدید
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link px-3" asp-controller="Reports" asp-action="Index">
                                            <i class="bi bi-bar-chart-line ms-1"></i>گزارش‌ها
                                        </a>
                                    </li>
                                }
                                @if (User.IsInRole(AppRoles.IT))
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown">
                                            <i class="bi bi-gear ms-1"></i>مدیریت پایه
                                        </a>
                                        <ul class="dropdown-menu shadow-lg border-0">
                                            <li><a class="dropdown-item py-2" asp-controller="Courts" asp-action="Index"><i class="bi bi-bank ms-2"></i>دادگاه‌ها</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Branches" asp-action="Index"><i class="bi bi-door-open ms-2"></i>شعب</a></li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Users" asp-action="Index"><i class="bi bi-people ms-2"></i>کاربران</a></li>
                                        </ul>
                                    </li>
                                }
                            }
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <div class="user-badge d-flex align-items-center gap-2">
                                <div class="user-avatar">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <span class="text-white-50 d-none d-lg-inline">@User.Identity!.Name</span>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                    <i class="bi bi-box-arrow-left ms-1"></i>خروج
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-content">
        <div class="container-fluid px-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show alert-professional no-print" role="alert">
                    <i class="bi bi-check-circle-fill ms-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show alert-professional no-print" role="alert">
                    <i class="bi bi-exclamation-triangle-fill ms-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="footer-professional no-print">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-end">
                    <span class="text-muted">© @DateTime.Now.Year سامانه ردیابی ارجاعات واحد ارشاد</span>
                </div>
                <div class="col-md-6 text-md-start text-muted">
                    <small>طراحی و توسعه با <i class="bi bi-heart-fill text-danger"></i></small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
