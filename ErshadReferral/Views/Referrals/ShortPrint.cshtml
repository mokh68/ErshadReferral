@model Referral
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>پرینت کوتاه @Model.ReferralNumber</title>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: Tahoma, Arial, sans-serif;
            direction: rtl;
            background: #fff;
        }
        .no-print {
            text-align: center;
            padding: 10px;
            background: #f5f5f5;
        }
        .receipt {
            width: 80mm;
            margin: 0 auto;
            padding: 3mm 4mm;
            font-size: 9pt;
            line-height: 1.6;
            color: #000;
            background: #fff;
        }
        .barcode-section {
            text-align: center;
            margin: 3mm 0;
        }
        .barcode-section svg {
            max-width: 100%;
        }
        .info-row {
            text-align: center;
            padding: 1mm 0;
            font-size: 8.5pt;
        }
        .info-row .label {
            font-weight: 600;
            color: #333;
        }
        .info-row .value {
            font-weight: 700;
            font-size: 10pt;
        }
        .print-btn {
            font-size: 14px;
            padding: 8px 24px;
            margin: 5px;
        }
        @@media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .receipt {
                width: 80mm;
                margin: 0;
                padding: 2mm 3mm;
            }
            @@page {
                size: 80mm auto;
                margin: 0;
            }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <p style="margin-bottom:8px;color:#666;">پرینت حرارتی کوتاه (۸ سانتی‌متر)</p>
        <button onclick="window.print()" class="btn btn-primary print-btn">
            <i class="bi bi-printer ms-1"></i>چاپ
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary print-btn">
            <i class="bi bi-x-circle ms-1"></i>بستن
        </button>
    </div>

    <div class="receipt" id="receipt">
        <!-- Barcode -->
        <div class="barcode-section">
            <svg id="barcode"></svg>
        </div>

        <!-- Referral Number -->
        <div class="info-row">
            <span class="label">شماره ارجاع: </span>
            <span class="value">@Model.ReferralNumber</span>
        </div>

        <!-- Date -->
        <div class="info-row">
            <span class="label">تاریخ: </span>
            <span class="value">@Model.ReferralDate.ToPersianDate()</span>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var nationalCode = '@Model.Person?.NationalCode';
            if (nationalCode && nationalCode.length === 10) {
                JsBarcode("#barcode", nationalCode, {
                    format: "CODE128",
                    width: 1.5,
                    height: 50,
                    displayValue: true,
                    fontSize: 14,
                    margin: 5,
                    textMargin: 2,
                    fontOptions: "bold"
                });
            }

            // Auto-print after 500ms
            setTimeout(function () {
                window.print();
            }, 500);
        });
    </script>
</body>
</html>
