@model ErrorViewModel
@{
    ViewData["Title"] = "خطا";
}

<div class="row justify-content-center mt-5 animate-fade-in">
    <div class="col-md-6 text-center">
        <div class="card">
            <div class="card-body py-5">
                <i class="bi bi-exclamation-triangle fs-1 text-danger mb-3"></i>
                <h3 class="text-danger mb-3">خطا رخ داد!</h3>
                <p class="text-muted mb-4">متأسفانه در پردازش درخواست شما خطایی رخ داده است.</p>
                
                @if (Model.ShowRequestId)
                {
                    <div class="p-3 rounded-3 mb-4" style="background: #f8f9fa;">
                        <small class="text-muted">شناسه درخواست:</small>
                        <code>@Model.RequestId</code>
                    </div>
                }
                
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house ms-1"></i>بازگشت به داشبورد
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left ms-1"></i>بازگشت
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
