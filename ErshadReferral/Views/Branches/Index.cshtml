@model IEnumerable<Branch>
@{
    ViewData["Title"] = "مدیریت شعب";
}

<div class="page-header animate-fade-in">
    <div class="d-flex justify-content-between align-items-center">
        <h4><i class="bi bi-door-open ms-2"></i>مدیریت شعب</h4>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle ms-1"></i>افزودن شعبه جدید
        </a>
    </div>
</div>

<div class="card animate-fade-in">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>دادگاه</th>
                        <th>شعبه</th>
                        <th>رئیس شعبه</th>
                        <th>تلفن داخلی</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var branch in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@branch.Court?.Name</td>
                            <td><strong>@branch.Name</strong></td>
                            <td>@(branch.JudgeName ?? "—")</td>
                            <td>@(branch.Phone ?? "—")</td>
                            <td>
                                @if (branch.IsActive)
                                {
                                    <span class="badge bg-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">غیرفعال</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleActive" asp-route-id="@branch.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-@(branch.IsActive ? "pause-circle" : "play-circle")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-door-open fs-1 text-muted"></i>
                <p class="text-muted mt-3">شعبه‌ای یافت نشد.</p>
            </div>
        }
    </div>
</div>
