@model Branch
@{
    ViewData["Title"] = "افزودن شعبه";
}

<div class="page-header animate-fade-in">
    <h4><i class="bi bi-plus-circle ms-2"></i>افزودن شعبه جدید</h4>
</div>

<div class="row justify-content-center animate-fade-in">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-door-open ms-2 text-success"></i>اطلاعات شعبه</h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CourtId" class="form-label">
                            <i class="bi bi-bank ms-1"></i>دادگاه
                        </label>
                        <select asp-for="CourtId" asp-items="ViewBag.Courts" class="form-select">
                            <option value="">-- انتخاب دادگاه --</option>
                        </select>
                        <span asp-validation-for="CourtId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-card-heading ms-1"></i>نام شعبه
                        </label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="JudgeName" class="form-label">
                            <i class="bi bi-person ms-1"></i>رئیس شعبه
                        </label>
                        <input asp-for="JudgeName" class="form-control" />
                        <span asp-validation-for="JudgeName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">
                            <i class="bi bi-telephone ms-1"></i>تلفن داخلی
                        </label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">فعال</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle ms-1"></i>ذخیره
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-right ms-1"></i>بازگشت
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
